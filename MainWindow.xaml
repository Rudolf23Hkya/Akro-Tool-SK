<Window x:Class="Atletika_SutaznyPlan_Generator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Atletika_SutaznyPlan_Generator.Converters"
        xmlns:vm="clr-namespace:Atletika_SutaznyPlan_Generator.ViewModels"
        Title="Akro Tool SK"
        Icon="assets/AkroTool_Icon.ico"
        Width="1300" Height="850"
        MinWidth="1100" MinHeight="750"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="White"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:RulebookToSlovakLabelConverter x:Key="RulebookToSlovakLabelConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- ‹ › on a Zvlášť Okno -->
        <Style x:Key="SlotArrowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Padding" Value="0,-4,0,0"/>
            <Setter Property="Background" Value="#E6FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1F5FA8"/>
            <Setter Property="Foreground" Value="#1F5FA8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Outer frame (now square, no clipping) -->
    <Border CornerRadius="0"
            Background="White"
            BorderBrush="Black"
            BorderThickness="0"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.Resources>
                <!-- Soft, rounded separators (used for all dividers) -->
                <Style x:Key="SoftSeparatorStyle" TargetType="Border">
                    <Setter Property="Background" Value="#B5B5B5"/>
                    <Setter Property="CornerRadius" Value="0"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="Opacity" Value="0.95"/>
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <!-- menu -->
                <RowDefinition Height="Auto"/>
                <!-- top controls -->
                <RowDefinition Height="Auto"/>
                <!-- thick separator (now uniform) -->
                <RowDefinition Height="*"/>
                <!-- main area -->
                <RowDefinition Height="44"/>
                <!-- footer -->
            </Grid.RowDefinitions>

            <!-- ===================== Menu ===================== -->
            <Menu Grid.Row="0" Background="#F2F2F2" BorderBrush="#C8C8C8" BorderThickness="0,1,0,1">
                <MenuItem Header="Súbor">
                    <MenuItem Header="Upraviť názov podujatia..." Click="EditEventName_Click"/>
                    <MenuItem Header="Upraviť trénera a klub..." Click="EditTrainerClub_Click"/>
                    <MenuItem Header="Exportovať PDF..." Command="{Binding ExportPdfCommand}"/>
                    <Separator/>
                    <MenuItem Header="Koniec" Command="{Binding ExitCommand}"/>
                </MenuItem>
                <MenuItem Header="História">
                    <MenuItem Header="Súťažné plány..." Command="{Binding OpenHistoryCommand}"/>
                </MenuItem>
                <MenuItem Header="Pomoc">
                    <MenuItem Header="Autorské práva" Click="ShowCopyright_Click"/>
                </MenuItem>
            </Menu>

            <!-- ===================== Top controls ===================== -->
            <Grid Grid.Row="1" Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Margin="0,0,0,10">
                    <Button Content="Tlačiť"
                            Command="{Binding ExportPdfCommand}"
                            Height="31"
                            Padding="13,4"
                            Margin="0,0,7,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="White"
                            BorderBrush="Black"
                            BorderThickness="2"
                            Cursor="Hand"/>
                    <Button Content="Vyčistiť tabuľku"
                            Command="{Binding ClearTableCommand}"
                            Height="31"
                            Padding="13,4"
                            Margin="0,0,7,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="White"
                            BorderBrush="Black"
                            BorderThickness="2"
                            Cursor="Hand"/>

                    <Border Background="White"
                            BorderBrush="Black"
                            BorderThickness="2"
                            Padding="13,6"
                            Margin="0,0,7,0">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center">
                            <Run Text="Obť.: "/>
                            <Run Text="{Binding Obtaznost, StringFormat={}{0:0.000}}"/>
                        </TextBlock>
                    </Border>

                    <Border Background="White"
                            BorderBrush="Black"
                            BorderThickness="2"
                            Padding="13,6">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Text="{Binding PickCounterText}"/>
                    </Border>
                </StackPanel>

                <!-- Left block: Category + Discipline -->
                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="Kategória" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <ComboBox Width="220"
                              Height="30"
                              ItemsSource="{Binding Rulebooks}"
                              SelectedItem="{Binding SelectedRulebook}"
                              VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource RulebookToSlovakLabelConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <GroupBox Grid.Row="1"
                              Header="Disciplína"
                              Margin="0,4,0,0"
                              BorderBrush="Black"
                              BorderThickness="2"
                              Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <RadioButton Content="Zmiešaná zostava"  Margin="0,6,0,0" IsChecked="{Binding IsCombi}" IsEnabled="{Binding IsDisciplineEnabled}"/>
                                <RadioButton Content="Dynamická zostava"  Margin="0,6,0,0" IsChecked="{Binding IsDynamic}" IsEnabled="{Binding IsDisciplineEnabled}"/>
                                <RadioButton Content="Balančná zostava" Margin="0,6,0,0" IsChecked="{Binding IsBalance}" IsEnabled="{Binding IsDisciplineEnabled}"/>
                            </StackPanel>

                            <!-- Separator (soft + rounded) -->
                            <Border Grid.Column="1"
                                    Width="4"
                                    Margin="3,2"
                                    Style="{StaticResource SoftSeparatorStyle}"/>

                            <StackPanel Grid.Column="2">
                                <RadioButton Content="WP"  Margin="0,6,0,0" GroupName="CategoryGroup" IsChecked="{Binding IsWP}" IsEnabled="{Binding IsWPEnabled}"/>
                                <RadioButton Content="MP"  Margin="0,6,0,0" GroupName="CategoryGroup" IsChecked="{Binding IsMP}" IsEnabled="{Binding IsMPEnabled}"/>
                                <RadioButton Content="MxP" Margin="0,6,0,0" GroupName="CategoryGroup" IsChecked="{Binding IsMxP}" IsEnabled="{Binding IsMxPEnabled}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <RadioButton Content="WG" Margin="0,6,0,0" GroupName="CategoryGroup" IsChecked="{Binding IsWG}" IsEnabled="{Binding IsWGEnabled}"/>
                                <RadioButton Content="MG" Margin="0,6,0,0" GroupName="CategoryGroup" IsChecked="{Binding IsMG}" IsEnabled="{Binding IsMGEnabled}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>

                <!-- Right block: 4 athlete cards -->
                <Grid Grid.Row="1" Grid.Column="1" Margin="24,0,0,0">
                    <Grid.Resources>
                        <Style x:Key="PersonCardStyle" TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                            <Setter Property="BorderBrush" Value="#D6D6D6"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="Background" Value="#F7F7F7"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="Margin" Value="10,0,0,0"/>
                        </Style>

                        <Style x:Key="NameBoxStyle" TargetType="TextBox">
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="Margin" Value="0,6,0,8"/>
                            <Setter Property="Padding" Value="6,3"/>
                        </Style>

                        <Style x:Key="BirthYearStyle" TargetType="ComboBox">
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="Margin" Value="0,6,0,8"/>
                            <Setter Property="Padding" Value="6,3"/>
                            <Setter Property="ItemsSource" Value="{Binding BirthYearOptions}"/>
                            <Setter Property="ToolTip" Value="Rok narodenia"/>
                        </Style>
                    </Grid.Resources>

                    <UniformGrid Columns="4" VerticalAlignment="Center">
                        <Border Style="{StaticResource PersonCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Top" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource NameBoxStyle}" Text="{Binding TopName, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Style="{StaticResource BirthYearStyle}" SelectedItem="{Binding TopBirthYear}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PersonCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Middle" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource NameBoxStyle}" Text="{Binding Middle1Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Style="{StaticResource BirthYearStyle}" SelectedItem="{Binding Middle1BirthYear}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PersonCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Middle" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource NameBoxStyle}" Text="{Binding Middle2Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Style="{StaticResource BirthYearStyle}" SelectedItem="{Binding Middle2BirthYear}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PersonCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Base" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource NameBoxStyle}" Text="{Binding BaseName, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Style="{StaticResource BirthYearStyle}" SelectedItem="{Binding BaseBirthYear}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Grid>

            <!-- ===================== Thick horizontal divider (soft + uniform) ===================== -->
            <Border Grid.Row="2"
                Height="4"
                HorizontalAlignment="Stretch"
                Margin="0"
                Style="{StaticResource SoftSeparatorStyle}"/>

            <!-- ===================== Main 12-tile area ===================== -->
            <Grid Grid.Row="3" Margin="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ExerciseSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10">
                                <!-- The tile fills the whole cell (#40): a centered tile left button area above/below
                                     it (8 Okno = taller cells) that turned blue on hover, and misplaced the overlays -->
                                <Button Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.OpenSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                    <Border CornerRadius="6"
                                BorderBrush="Black"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="34"/>
                                            </Grid.RowDefinitions>

                                            <!-- Fixed picture area (shape of the classic 1032×536 pictures): the tile
                                                 height never depends on the picture; tall/wide pictures fit whole -->
                                            <Border Grid.Row="0" Background="White">
                                                <Viewbox Stretch="Uniform">
                                                    <Grid Width="1032" Height="536">
                                                        <Image Source="{Binding Image}"
                                                               Stretch="Uniform"/>
                                                    </Grid>
                                                </Viewbox>
                                            </Border>

                                            <Border Grid.Row="1"
                                        Background="White"
                                        BorderBrush="Black"
                                        BorderThickness="0,1,0,0">
                                                <TextBlock Text="{Binding Label}"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Button>

                                <!-- Overlays on the picture area. Siblings of the tile button (not nested),
                                     so clicking them never opens the normal picker. -->
                                <Grid Margin="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="34"/>
                                    </Grid.RowDefinitions>

                                    <!-- Zvlášť: who performs the exercise shown right now -->
                                    <Border HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Margin="0,6,0,0"
                                            Padding="8,2"
                                            CornerRadius="4"
                                            Background="#E6FFFFFF"
                                            BorderBrush="#1F5FA8"
                                            BorderThickness="1"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsSeparate, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding PerformerText}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F5FA8"/>
                                    </Border>

                                    <Button Content="‹"
                                            HorizontalAlignment="Left"
                                            Margin="4,0,0,0"
                                            Style="{StaticResource SlotArrowButtonStyle}"
                                            AutomationProperties.Name="Predchádzajúce cvičenie"
                                            Command="{Binding DataContext.ShowPreviousExerciseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsSeparate, Converter={StaticResource BoolToVisibility}}"/>

                                    <Button Content="›"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,4,0"
                                            Style="{StaticResource SlotArrowButtonStyle}"
                                            AutomationProperties.Name="Ďalšie cvičenie"
                                            Command="{Binding DataContext.ShowNextExerciseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsSeparate, Converter={StaticResource BoolToVisibility}}"/>

                                    <!-- Empty Okno in a team age group while an Inv pick is left: one Inv exercise per team member (issues #29, #43) -->
                                    <Button Content="Zvlášť"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,6,6"
                                            Padding="10,3"
                                            FontWeight="SemiBold"
                                            Background="White"
                                            BorderBrush="#1F5FA8"
                                            Foreground="#1F5FA8"
                                            Cursor="Hand"
                                            ToolTip="Zvoliť individuálne cvičenie zvlášť pre každého pretekára"
                                            Command="{Binding DataContext.SeparateSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanSeparate, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ===================== Footer (soft top separator, uniform thickness) ===================== -->
            <Border Grid.Row="4" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                        Height="4"
                        HorizontalAlignment="Stretch"
                        Margin="0"
                        Style="{StaticResource SoftSeparatorStyle}"/>

                    <Grid Grid.Row="1" Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                           Text="{Binding TrainerName, StringFormat=Tréner: {0}}"
                           FontSize="22"
                           VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                           Text="{Binding ClubName, StringFormat=   |   Názov klubu: {0}}"
                           FontSize="22"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"/>

                        <TextBlock Grid.Column="3"
                           Text="{Binding EventName, StringFormat=Podujatie: {0}}"
                           FontSize="22"
                           VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>