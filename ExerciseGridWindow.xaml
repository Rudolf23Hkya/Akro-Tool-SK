<Window x:Class="Atletika_SutaznyPlan_Generator.ExerciseGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1250" Height="850"
        MinWidth="1050" MinHeight="700"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="White"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="ImageButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
                <!-- No exercise at this position in the rulebook: keep the grid cell, show nothing -->
                <DataTrigger Binding="{Binding IsEmptyCell}" Value="True">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ExerciseImageButtonTemplate">
            <Button Style="{StaticResource ImageButtonStyle}"
            Command="{Binding DataContext.ExerciseClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
            CommandParameter="{Binding}"
            IsEnabled="{Binding IsSelectable}">
                <!-- Fixed tile size (picture area 238×124 = the 1032×536 shape + label): the whole grid is
                     scaled to the window by the Viewbox below -->
                <Border CornerRadius="8"
                Width="240" Height="152"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                SnapsToDevicePixels="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBlockedByRowRule}" Value="True">
                                    <Setter Property="Opacity" Value="0.45"/>
                                    <Setter Property="Background" Value="#E5E5E5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="26"/>
                        </Grid.RowDefinitions>

                        <!-- Picture area in the shape of the classic pictures (1032×536): every tile gets the same
                             height and any picture fits whole. The pictures from #27 are cropped tight and range
                             from tall to wide, so they must not be stretched or cut. -->
                        <Border Grid.Row="0" Background="White" ClipToBounds="True">
                            <Viewbox Stretch="Uniform">
                                <Grid Width="1032" Height="536">
                                    <Image Source="{Binding Image,
                                    TargetNullValue='pack://application:,,,/assets/sgf_logo1.png',
                                    FallbackValue='pack://application:,,,/assets/sgf_logo1.png'}"
                                   Stretch="Uniform"
                                   Margin="52,27"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Viewbox>
                        </Border>

                        <Border Grid.Row="1" Background="White" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
                            <TextBlock Text="{Binding Label}"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border Background="White" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WindowTitle}"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                    <ToggleButton Margin="14,0,0,0"
                          Padding="12,6"
                          VerticalAlignment="Center"
                          IsChecked="{Binding ShowIndividualTable, Mode=TwoWay}"
                          IsEnabled="{Binding CanToggleIndividual}"
                          Visibility="{Binding IsTableToggleVisible, Converter={StaticResource BoolToVisibility}}"
                          Content="{Binding ToggleText}" />

                    <!-- Zvlášť: which team member is choosing -->
                    <TextBlock Text="{Binding Subtitle}"
                               Margin="18,0,0,0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1F5FA8"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Zavrieť"
                        Width="110" Height="34"
                        BorderBrush="Black"
                        BorderThickness="2"
                        Background="White"
                        Click="Close_Click"/>
            </Grid>

            <!-- Rows x columns grid of exercises (size comes from the table definition). The whole table is
                 scaled to fit the window — never a scroll bar (#39) — centered, top-aligned. -->
            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both"
                     HorizontalAlignment="Center" VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding VisibleExercises}"
                              ItemTemplate="{StaticResource ExerciseImageButtonTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding VisibleColumns}" Rows="{Binding VisibleRows}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Viewbox>
        </Grid>
    </Border>
</Window>
