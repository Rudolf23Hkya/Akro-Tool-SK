<Window x:Class="Atletika_SutaznyPlan_Generator.Views.PlanHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="História – súťažné plány"
        Width="560" Height="640"
        MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Vytlačené súťažné plány (najnovšie hore)"
               FontSize="14"
               Margin="0,0,0,8"/>

    <ListBox x:Name="PlanList"
             Grid.Row="1"
             ItemsSource="{Binding Items}"
             SelectedItem="{Binding SelectedItem}"
             AutomationProperties.AutomationId="PlanHistoryList"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <EventSetter Event="MouseDoubleClick" Handler="PlanItem_DoubleClick"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <StackPanel>
                  <!-- At least one month between this plan and the newer one above (issue #45) -->
                  <Border Height="3"
                          Margin="0,6,0,6"
                          Background="#505050"
                          Visibility="{Binding IsSeparatorAbove, Converter={StaticResource BoolToVisibility}}"/>
                  <Border x:Name="ItemBorder"
                          Background="{TemplateBinding Background}"
                          BorderBrush="#E0E0E0"
                          BorderThickness="0,0,0,1"
                          Padding="8,6">
                    <ContentPresenter/>
                  </Border>
                </StackPanel>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#E5F3FB"/>
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#CCE4F7"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CanLoad}" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="{Binding NamesText}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding CategoryText}" FontSize="13" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding DetailsText}" FontSize="11" Foreground="#707070" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="1"
               Text="Zatiaľ nebol vytlačený žiadny súťažný plán."
               Foreground="#707070"
               FontSize="13"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               TextWrapping="Wrap"
               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="Načítať"
              Width="100"
              Margin="0,0,8,0"
              IsDefault="True"
              Command="{Binding LoadCommand}"/>
      <Button Content="Odstrániť"
              Width="100"
              Margin="0,0,8,0"
              Command="{Binding RemoveCommand}"/>
      <Button Content="Zavrieť"
              Width="90"
              IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
